# Copy to .env and .env.local. Do not commit real secrets.
#
# This project uses PostgressOps: PgBouncer on SERVER:6432.
# Prisma schema requires both DATABASE_URL (pooled) and DIRECT_URL.

# PostgreSQL via PgBouncer (password URL-encoded: + → %2B)
DATABASE_URL="postgresql://mtruck_nextjs:PASSWORD@173.242.62.135:6432/mtruck_nextjs?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://mtruck_nextjs:PASSWORD@173.242.62.135:6432/mtruck_nextjs?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Better-Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="test@admin.com"
ADMIN_TEST_EMAIL="test@admin.com"
NEXT_PUBLIC_ADMIN_EMAIL="test@admin.com"
NEXT_PUBLIC_ADMIN_TEST_EMAIL="test@admin.com"

# Google OAuth (optional). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH="false"

# App URL
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000/"
