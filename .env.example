# Copy to .env and fill in secrets. Do not commit .env.
#
# This project uses PostgressOps: PgBouncer on SERVER:6432.
# Prisma needs DATABASE_URL (transaction pool) + DIRECT_URL (session alias).
# Password URL-encoded: + → %2B
#
# mtruck_nextjs_direct is a PgBouncer [databases] alias with pool_mode=session
# so prisma db push / migrate can use prepared statements.

DATABASE_URL="postgresql://mtruck_nextjs:PASSWORD@173.242.62.135:6432/mtruck_nextjs?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://mtruck_nextjs:PASSWORD@173.242.62.135:6432/mtruck_nextjs_direct?connection_limit=1"

# Better-Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"

# Admin bootstrap (seed writes this user to DB once and sets role=ADMIN)
ADMIN_EMAIL="admin@m-truck.ua"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_NAME="M-TRUCK"
# Optional extra admin emails promoted by seed
# ADMIN_TEST_EMAIL=""

# Google OAuth (optional). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH="false"

# App URL
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000/"
