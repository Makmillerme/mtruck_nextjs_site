# Copy to the VPS as /opt/rustkibitka/.env (not committed).
# Used by systemd EnvironmentFile= and deploy scripts.

RUST_HOSTNAME=FarmKibitka
RUST_DESCRIPTION=Farm Kibitka — a house for farming
RUST_URL=
RUST_HEADERIMAGE=

RUST_MAXPLAYERS=40
RUST_WORLDSIZE=3500
RUST_SEED=12345
RUST_LEVEL=Procedural Map

RUST_SERVER_IP=0.0.0.0
RUST_SERVER_PORT=28015
RUST_QUERY_PORT=28015
RUST_RCON_PORT=28016
RUST_RCON_PASSWORD=change-me-long-random
RUST_RCON_WEB=1

# Bind RCON to loopback on the VPS; manage via SSH tunnel.
RUST_RCON_IP=127.0.0.1

RUST_IDENTITY=farmkibitka
RUST_SAVE_INTERVAL=300
RUST_TICKRATE=30

# Optional Steam app branch (empty = public)
STEAM_BRANCH=
