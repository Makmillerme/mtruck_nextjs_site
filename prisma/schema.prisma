datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum AttributeType {
  SELECT
  MULTI_SELECT
  NUMBER
  TEXT
  BOOLEAN
  YEAR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
}

enum ProductAvailability {
  IN_STOCK
  TRANSIT
  ON_ORDER
}

enum PriceEntryMode {
  INCL_VAT
  EXCL_VAT
}

enum PriceDisplayMode {
  SINGLE
  STACKED
}

enum PromoKind {
  AMOUNT
  PERCENT
}

enum OrderKind {
  CATALOG
  REQUEST
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum OrderOrigin {
  USER
  ADMIN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum SheetWidth {
  FULL
  HALF
  THIRD
}

enum TextInput {
  LINE
  AREA
}

enum ProductPageTabKind {
  TEXT
  TABLE
  LIST
}

enum ProductPageSystemSource {
  DESCRIPTION
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  phone         String?
  userCode      String    @unique
  role          UserRole  @default(USER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  products      Product[]
  favorites     Favorite[]
  reviews       Review[]
  orders        Order[]
  phones        UserPhone[]
  archivedAt    DateTime?

  @@index([phone])
  @@index([archivedAt])
}

// Extra phones from logged-in CTA/forms when primary User.phone is already set
model UserPhone {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  phoneNorm String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phoneNorm])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
}

model Currency {
  code            String    @id
  name            String
  nameEn          String
  numericCode     Int?
  minorUnits      Int       @default(2)
  isActive        Boolean   @default(true)
  isBuyerVisible  Boolean   @default(true)
  rateToBase      Decimal?  @db.Decimal(18, 8)
  rateUpdatedAt   DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  baseForSettings FinanceSettings[] @relation("FinanceBaseCurrency")
  siteForSettings FinanceSettings[] @relation("FinanceSiteCurrency")
  rootPricingMain RootPricing[] @relation("RootPricingMainCurrency")
  rootPricingVatDisplay RootPricing[] @relation("RootPricingVatDisplayCurrency")
  rootPricingExtra RootPricingCurrency[]
}

enum CurrencyDisplayMode {
  CODE
  SYMBOL
}

model FinanceSettings {
  id                       String              @id @default("default")
  baseCurrencyCode         String
  baseCurrency             Currency            @relation("FinanceBaseCurrency", fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  siteCurrencyCode         String
  siteCurrency             Currency            @relation("FinanceSiteCurrency", fields: [siteCurrencyCode], references: [code], onDelete: Restrict)
  allowBuyerCurrencySwitch Boolean             @default(false)
  currencyDisplayMode      CurrencyDisplayMode @default(CODE)
  updatedAt                DateTime            @updatedAt
}

model Product {
  id             String               @id @default(uuid())
  name           String
  description    String
  image          String
  price          Int
  currency       String               @default("USD")
  currencyRef    Currency             @relation(fields: [currency], references: [code], onDelete: Restrict)
  promoKind      PromoKind?
  promoValue     Decimal?             @db.Decimal(18, 4)
  productCode    String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites      Favorite[]
  reviews        Review[]
  orders            Order[]
  callbackInquiries CallbackInquiry[]
  taxonomyNodeId    String?
  taxonomyNode   TaxonomyNode?        @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  status         ProductStatus        @default(PUBLISHED)
  availability   ProductAvailability  @default(IN_STOCK)
  specs          ProductSpec[]
  images         ProductImage[]
  archivedAt     DateTime?

  @@index([taxonomyNodeId])
  @@index([status])
  @@index([archivedAt])
  @@index([archivedAt, createdAt])
  @@index([status, archivedAt, createdAt])
  @@index([status, archivedAt, taxonomyNodeId, createdAt])
  @@index([status, archivedAt, price])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model TaxonomyNode {
  id        String   @id @default(uuid())
  parentId  String?
  parent    TaxonomyNode?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  TaxonomyNode[] @relation("TaxonomyTree")
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive         Boolean @default(true)
  showInFilter     Boolean @default(true)
  showInHomeFilter Boolean @default(true)
  /// Root-only setting; inherited by the whole branch. Unique listings lock order qty to 1.
  productsAreUnique Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes          AttributeDefinition[]
  displayGroups       DisplayGroup[]
  products            Product[]
  orders              Order[]
  cardPreviewLayout   CardPreviewLayout?
  productPageLayout   ProductPageLayout?
  rootPricing         RootPricing?

  @@index([parentId])
}

model RootPricing {
  id                       String           @id @default(uuid())
  taxonomyNodeId           String           @unique
  taxonomyNode             TaxonomyNode     @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  vatEnabled               Boolean          @default(true)
  entryMode                PriceEntryMode   @default(INCL_VAT)
  /// Which amount buyers see as the main price: with VAT or without.
  storefrontPriceMode      PriceEntryMode   @default(INCL_VAT)
  vatPercent               Decimal          @default(0) @db.Decimal(8, 4)
  showPriceWithVat         Boolean          @default(true)
  showPriceWithoutVat      Boolean          @default(false)
  showVatAmount            Boolean          @default(false)
  displayMode              PriceDisplayMode @default(SINGLE)
  mainCurrencyCode         String
  mainCurrency             Currency         @relation("RootPricingMainCurrency", fields: [mainCurrencyCode], references: [code], onDelete: Restrict)
  vatDisplayCurrencyCode   String?
  vatDisplayCurrency       Currency?        @relation("RootPricingVatDisplayCurrency", fields: [vatDisplayCurrencyCode], references: [code], onDelete: Restrict)
  allowBuyerCurrencySwitch Boolean          @default(false)
  /// Show financing estimate on PDP for products under this root.
  financingEnabled         Boolean          @default(true)
  /// Buyer-facing VAT amount rows. Taxes can stay on while this is off.
  vatSumsEnabled           Boolean          @default(true)
  creditAnnualRatePercent  Decimal          @default(14) @db.Decimal(8, 4)
  creditTermMonthsMin      Int              @default(12)
  creditTermMonthsMax      Int              @default(60)
  creditTermMonthsDefault  Int              @default(36)
  creditTermMonthsStep     Int              @default(1)
  creditDownPaymentPercentMin Decimal       @default(0) @db.Decimal(8, 4)
  creditDownPaymentPercentMax Decimal       @default(50) @db.Decimal(8, 4)
  creditDownPaymentPercentDefault Decimal   @default(20) @db.Decimal(8, 4)
  creditDownPaymentPercentStep Decimal      @default(1) @db.Decimal(8, 4)
  leaseAnnualRatePercent   Decimal          @default(12) @db.Decimal(8, 4)
  leaseTermMonthsMin       Int              @default(12)
  leaseTermMonthsMax       Int              @default(48)
  leaseTermMonthsDefault   Int              @default(36)
  leaseTermMonthsStep      Int              @default(1)
  leaseDownPaymentPercentMin Decimal        @default(0) @db.Decimal(8, 4)
  leaseDownPaymentPercentMax Decimal        @default(40) @db.Decimal(8, 4)
  leaseDownPaymentPercentDefault Decimal    @default(10) @db.Decimal(8, 4)
  leaseDownPaymentPercentStep Decimal       @default(1) @db.Decimal(8, 4)
  leaseResidualPercent     Decimal          @default(45) @db.Decimal(8, 4)
  /// Which quote rows buyers see under the monthly figure.
  financingShowDown        Boolean          @default(true)
  financingShowResidual    Boolean          @default(true)
  financingShowTotal       Boolean          @default(true)
  financingShowRate        Boolean          @default(true)
  extraCurrencies          RootPricingCurrency[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

model RootPricingCurrency {
  id            String      @id @default(uuid())
  rootPricingId String
  rootPricing   RootPricing @relation(fields: [rootPricingId], references: [id], onDelete: Cascade)
  currencyCode  String
  currency      Currency    @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  sortOrder     Int         @default(0)

  @@unique([rootPricingId, currencyCode])
  @@index([rootPricingId])
}

model AttributeDefinition {
  id                   String        @id @default(uuid())
  taxonomyNodeId       String
  taxonomyNode         TaxonomyNode  @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  key                  String
  name                 String
  type                 AttributeType
  dependsOnAttributeId String?
  dependsOn            AttributeDefinition?  @relation("AttributeDepends", fields: [dependsOnAttributeId], references: [id], onDelete: Restrict)
  dependents           AttributeDefinition[] @relation("AttributeDepends")
  isRequired           Boolean       @default(false)
  isFacet              Boolean       @default(true)
  showInHomeFilter     Boolean       @default(true)
  unit                 String?
  sheetWidth           SheetWidth    @default(FULL)
  textInput            TextInput     @default(LINE)
  sortOrder            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  options                  AttributeOption[]
  specs                    ProductSpec[]
  displayGroupMembers      DisplayGroupMember[]
  formationTargets         DisplayGroup[]       @relation("FormationTarget")
  cardPreviewSlots         CardPreviewSlot[]
  cardPreviewSubtitleSlots CardPreviewSubtitleSlot[]
  productPageSpecSlots     ProductPageSpecSlot[]
  productPageKeyFactSlots  ProductPageKeyFactSlot[]
  productPageTabSlots      ProductPageTabSlot[]

  @@unique([taxonomyNodeId, key])
  @@index([taxonomyNodeId])
  @@index([dependsOnAttributeId])
}

model AttributeOption {
  id             String   @id @default(uuid())
  attributeId    String
  attribute      AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  parentOptionId String?
  parent         AttributeOption?  @relation("OptionTree", fields: [parentOptionId], references: [id], onDelete: Cascade)
  children       AttributeOption[] @relation("OptionTree")
  label          String
  slug           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  specs            ProductSpec[]
  selectedInSpecs  ProductSpecOption[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@index([parentOptionId])
}

model ProductSpec {
  id           String              @id @default(uuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  optionId     String?
  option       AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)
  numberValue  Float?
  textValue    String?
  booleanValue Boolean?
  selectedOptions ProductSpecOption[]

  @@unique([productId, attributeId])
  @@index([attributeId, optionId])
  @@index([productId])
}

model ProductSpecOption {
  id           String          @id @default(uuid())
  productSpecId String
  productSpec  ProductSpec     @relation(fields: [productSpecId], references: [id], onDelete: Cascade)
  optionId     String
  option       AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([productSpecId, optionId])
  @@index([optionId])
  @@index([productSpecId])
}

model DisplayGroup {
  id                 String               @id @default(uuid())
  taxonomyNodeId     String
  taxonomyNode       TaxonomyNode         @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  key                String
  name               String
  separator          String               @default(" ")
  sortOrder          Int                  @default(0)
  writesProductName  Boolean              @default(false)
  targetAttributeId  String?
  targetAttribute    AttributeDefinition? @relation("FormationTarget", fields: [targetAttributeId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  members DisplayGroupMember[]

  @@unique([taxonomyNodeId, key])
  @@index([taxonomyNodeId])
  @@index([targetAttributeId])
}

model DisplayGroupMember {
  id          String              @id @default(uuid())
  groupId     String
  group       DisplayGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)

  @@unique([groupId, attributeId])
  @@index([groupId])
  @@index([attributeId])
}

enum CardPreviewSpecsStyle {
  GRID
  TAGS
}

enum CardPreviewCategorySource {
  LAYOUT_FOLDER
  PRODUCT_FOLDER
}

model CardPreviewLayout {
  id             String                     @id @default(uuid())
  taxonomyNodeId String                     @unique
  taxonomyNode   TaxonomyNode               @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  showName       Boolean                    @default(true)
  showPrice      Boolean                    @default(true)
  showStatus     Boolean                    @default(true)
  showSubtitle   Boolean                    @default(true)
  showSpecs      Boolean                    @default(true)
  specsStyle     CardPreviewSpecsStyle      @default(GRID)
  specsGridCount Int                        @default(4)
  categorySource CardPreviewCategorySource  @default(PRODUCT_FOLDER)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  slots         CardPreviewSlot[]
  subtitleSlots CardPreviewSubtitleSlot[]
}

model CardPreviewSlot {
  id          String              @id @default(uuid())
  layoutId    String
  layout      CardPreviewLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)

  @@unique([layoutId, attributeId])
  @@index([layoutId])
  @@index([attributeId])
}

model CardPreviewSubtitleSlot {
  id          String              @id @default(uuid())
  layoutId    String
  layout      CardPreviewLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)

  @@unique([layoutId, attributeId])
  @@index([layoutId])
  @@index([attributeId])
}

model ProductPageLayout {
  id             String       @id @default(uuid())
  taxonomyNodeId String       @unique
  taxonomyNode   TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  keyFactsMax    Int          @default(6)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  slots         ProductPageSpecSlot[]
  keyFactSlots  ProductPageKeyFactSlot[]
  tabs          ProductPageTab[]
}

model ProductPageSpecSlot {
  id          String              @id @default(uuid())
  layoutId    String
  layout      ProductPageLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)
  visible     Boolean             @default(true)

  @@unique([layoutId, attributeId])
  @@index([layoutId])
  @@index([attributeId])
}

model ProductPageKeyFactSlot {
  id          String              @id @default(uuid())
  layoutId    String
  layout      ProductPageLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)
  visible     Boolean             @default(true)

  @@unique([layoutId, attributeId])
  @@index([layoutId])
  @@index([attributeId])
}

model ProductPageTab {
  id       String             @id @default(uuid())
  layoutId String
  layout   ProductPageLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  name     String
  kind     ProductPageTabKind @default(TABLE)
  sortOrder Int               @default(0)

  slots ProductPageTabSlot[]

  @@index([layoutId])
}

model ProductPageTabSlot {
  id           String                   @id @default(uuid())
  tabId        String
  tab          ProductPageTab           @relation(fields: [tabId], references: [id], onDelete: Cascade)
  attributeId  String?
  attribute    AttributeDefinition?     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  systemSource ProductPageSystemSource?
  sortOrder    Int                      @default(0)
  visible      Boolean                  @default(true)

  @@index([tabId])
  @@index([attributeId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  authorName     String
  authorImageUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Order {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           OrderKind    @default(CATALOG)
  status         OrderStatus  @default(NEW)
  origin         OrderOrigin  @default(ADMIN)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxonomyNodeId String?
  taxonomyNode   TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  specs          Json?
  note           String?
  products       Int          @default(1)
  orderTotal     Int          @default(0)
  tax            Int          @default(0)
  shipping       Int          @default(0)
  email          String
  isPaid         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  // Staff notification read (USER REQUEST leads)
  readAt         DateTime?

  @@index([userId])
  @@index([productId])
  @@index([taxonomyNodeId])
  @@index([kind])
  @@index([status])
  @@index([origin])
  @@index([archivedAt])
  @@index([readAt])
  @@index([userId, archivedAt, createdAt])
}

// Phone callback / CTA lead (anonymous site inquiry).
model CallbackInquiry {
  id          String         @id @default(uuid())
  phone       String
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  productCode String?
  status      InquiryStatus  @default(NEW)
  note        String?
  readAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  archivedAt  DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([productId])
  @@index([archivedAt])
}


