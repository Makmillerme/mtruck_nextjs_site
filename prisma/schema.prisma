datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

enum AttributeType {
  SELECT
  NUMBER
  TEXT
  BOOLEAN
  YEAR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  RESERVED
  PREPARING
  SOLD
}

enum ProductAvailability {
  IN_STOCK
  TRANSIT
}

enum OrderKind {
  CATALOG
  REQUEST
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum OrderOrigin {
  USER
  ADMIN
}

enum SheetWidth {
  FULL
  HALF
  THIRD
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  phone         String?
  userCode      String    @unique
  role          UserRole  @default(USER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  products      Product[]
  favorites     Favorite[]
  reviews       Review[]
  orders        Order[]
  archivedAt    DateTime?

  @@index([phone])
  @@index([archivedAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
}

model Product {
  id             String               @id @default(uuid())
  name           String
  company        String
  description    String
  featured       Boolean
  image          String
  price          Int
  productCode    String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites      Favorite[]
  reviews        Review[]
  orders         Order[]
  taxonomyNodeId String?
  taxonomyNode   TaxonomyNode?        @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  status         ProductStatus        @default(PUBLISHED)
  availability   ProductAvailability  @default(IN_STOCK)
  specs          ProductSpec[]
  images         ProductImage[]
  archivedAt     DateTime?

  @@index([taxonomyNodeId])
  @@index([status])
  @@index([archivedAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model TaxonomyNode {
  id        String   @id @default(uuid())
  parentId  String?
  parent    TaxonomyNode?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  TaxonomyNode[] @relation("TaxonomyTree")
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive      Boolean @default(true)
  showInFilter  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes    AttributeDefinition[]
  displayGroups DisplayGroup[]
  products      Product[]
  orders        Order[]

  @@index([parentId])
}

model AttributeDefinition {
  id                   String        @id @default(uuid())
  taxonomyNodeId       String
  taxonomyNode         TaxonomyNode  @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  key                  String
  name                 String
  type                 AttributeType
  dependsOnAttributeId String?
  dependsOn            AttributeDefinition?  @relation("AttributeDepends", fields: [dependsOnAttributeId], references: [id], onDelete: Restrict)
  dependents           AttributeDefinition[] @relation("AttributeDepends")
  isRequired           Boolean       @default(false)
  isFacet              Boolean       @default(true)
  isIdentity           Boolean       @default(false)
  unit                 String?
  sheetWidth           SheetWidth    @default(FULL)
  sortOrder            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  options             AttributeOption[]
  specs               ProductSpec[]
  displayGroupMembers DisplayGroupMember[]

  @@unique([taxonomyNodeId, key])
  @@index([taxonomyNodeId])
  @@index([dependsOnAttributeId])
}

model AttributeOption {
  id             String   @id @default(uuid())
  attributeId    String
  attribute      AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  parentOptionId String?
  parent         AttributeOption?  @relation("OptionTree", fields: [parentOptionId], references: [id], onDelete: Cascade)
  children       AttributeOption[] @relation("OptionTree")
  label          String
  slug           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  specs ProductSpec[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@index([parentOptionId])
}

model ProductSpec {
  id           String              @id @default(uuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  optionId     String?
  option       AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)
  numberValue  Float?
  textValue    String?
  booleanValue Boolean?

  @@unique([productId, attributeId])
  @@index([attributeId, optionId])
  @@index([productId])
}

model DisplayGroup {
  id                String       @id @default(uuid())
  taxonomyNodeId    String
  taxonomyNode      TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Cascade)
  key               String
  name              String
  separator         String       @default(" ")
  sortOrder         Int          @default(0)
  writesProductName Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  members DisplayGroupMember[]

  @@unique([taxonomyNodeId, key])
  @@index([taxonomyNodeId])
}

model DisplayGroupMember {
  id          String              @id @default(uuid())
  groupId     String
  group       DisplayGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                 @default(0)

  @@unique([groupId, attributeId])
  @@index([groupId])
  @@index([attributeId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  authorName     String
  authorImageUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           OrderKind    @default(CATALOG)
  status         OrderStatus  @default(NEW)
  origin         OrderOrigin  @default(ADMIN)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxonomyNodeId String?
  taxonomyNode   TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  specs          Json?
  note           String?
  products       Int          @default(1)
  orderTotal     Int          @default(0)
  tax            Int          @default(0)
  shipping       Int          @default(0)
  email          String
  isPaid         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?

  @@index([userId])
  @@index([productId])
  @@index([taxonomyNodeId])
  @@index([kind])
  @@index([status])
  @@index([origin])
  @@index([archivedAt])
}
